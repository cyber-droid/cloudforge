# CloudForge Environment Configuration

# Application
ENVIRONMENT=development
PROJECT_NAME="CloudForge API"
API_V1_STR="/api/v1"
DEBUG=true

# Security
SECRET_KEY="supersecret_cloudforge_dev_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=cloudforge_secret_pw
POSTGRES_DB=cloudforge_db

# Asynchronous DB URL (used by SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://cloudforge:cloudforge_secret_pw@localhost:5433/cloudforge_db

# CORS Allowed Origins (Comma-separated list or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
